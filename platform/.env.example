# Environment variables of the platform Lambdas / runtime. NO SECRETS belong here:
# nothing below is sensitive, and real secrets (e.g. a future 211 API key) go in SSM SecureString / Secrets Manager.

ENV_NAME=pilot
AWS_DEFAULT_REGION=us-east-2

# DynamoDB
DATA_TABLE=navigator-data-pilot
USAGE_TABLE=navigator-usage-pilot

# Cognito (public identifiers)
COGNITO_USER_POOL_ID=us-east-2_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_GROUP=pilot-admin
ALLOWED_ORIGINS=https://agents.sudhirmishra.in,http://localhost:5173

# AgentCore runtime + models
AGENT_RUNTIME_ARN=
AGENT_REGION=us-east-2
ORCHESTRATOR_MODEL_ID=us.amazon.nova-lite-v1:0
CLASSIFIER_MODEL_ID=us.amazon.nova-micro-v1:0

# Switches
ASSISTANT_ENABLED=true
MOCK_MODE=false           # true = local mock answers, no AgentCore/Location calls
SEED_DEMO=true            # seeds the clearly-labeled fictional `demo` namespace

# Data sources
SOURCE_OSM_ENABLED=true
SOURCE_NYC_CFC_ENABLED=true
SOURCE_211_ENABLED=false  # stays false until 211 access is authorized
SOURCE_211_API_KEY_PARAM= # SSM parameter NAME (never the key itself)
OVERPASS_URL=https://overpass-api.de/api/interpreter
INGEST_CONTACT=you@example.com   # goes in the User-Agent, as public data sources request
STALE_AFTER_DAYS=45

# Offline sync (network blocked / demos): read fixtures/ instead of calling the public APIs
FIXTURE_MODE=false
FIXTURE_DIR=fixtures
