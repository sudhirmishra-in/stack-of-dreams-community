# Copy to .env.local. Never put secrets in VITE_ variables: they are bundled into public JavaScript.

# Chat API (Lambda Function URL, no trailing slash needed). Used when mock mode is off.
VITE_API_BASE_URL=
VITE_USE_MOCK_API=true

# Authentication: none | mock | oidc   (values below are public identifiers, not secrets)
VITE_AUTH_MODE=none
# Issuer URL only, NOT the .well-known URL. Cognito: https://cognito-idp.<region>.amazonaws.com/<userPoolId>
VITE_AUTH_AUTHORITY=
VITE_AUTH_CLIENT_ID=
VITE_AUTH_REDIRECT_URI=
VITE_AUTH_SCOPE=openid email
VITE_AUTH_LOGOUT_DOMAIN=
# Set to true only after Google is enabled on the Cognito app client (see platform/docs/google-signin.md).
VITE_AUTH_GOOGLE=false

# Community Resource Navigator data (true = built-in synthetic demo data)
VITE_USE_MOCK_RESOURCES=true
VITE_RESOURCE_API_BASE_URL=

# --- Pilot platform (Community Navigator) ---
# Base URL of the pilot API (Lambda Function URL from the `navigator-pilot` stack output ApiBaseUrl). No trailing slash.
# When set, /ai-for-good/assistant uses the community-navigator assistant; when empty it falls back to the
# existing /chat service and the page says so.
VITE_PILOT_API_BASE_URL=
# Set VITE_USE_MOCK_RESOURCES=false to read real directory data from the pilot API (requires sign-in).

# The map needs no key: tiles are relayed by the pilot API using the signed-in user's token (the account blocks
# browser-side Amazon Location keys). It appears automatically when VITE_PILOT_API_BASE_URL is set and
# VITE_USE_MOCK_RESOURCES=false.
